      "properties": {
        "minCountForNew": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "Must not exceed maxCount; checked by Flare."
        },
        "maxCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "maxBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "supportedMimeTypes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Supported MIME type or subtype wildcard.",
            "pattern": "^(?:[A-Za-z0-9!#$&^_.+-]+/(?:[A-Za-z0-9!#$&^_.+-]+|\\*))(?![\\s\\S])"
          },
          "default": [],
          "maxItems": 128,
          "uniqueItems": true
        },
        "altTextMaxLength": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000,
          "default": 1500
        },
        "canSensitive": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "maxCount",
        "maxBytes"
      ]
    },
    "composeVisibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/visibility"
          },
          "default": [],
          "minItems": 1,
          "uniqueItems": true,
          "description": "The default visibility must be a member; checked by Flare."
        },
        "default": {
          "allOf": [{ "$ref": "#/definitions/visibility" }],
          "default": "public"
        }
      },
      "required": [
        "allowed"
      ]
    },
    "composePoll": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOptions": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        }
      },
      "required": [
