{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flare plugin manifest — API v1",
  "description": "Editor assistance for manifest structure and static rules. Flare remains authoritative for registration, unique IDs, origin approval, locale catalogs, cross-field values and runtime behavior. The Host never fetches the $schema URL.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": [
        "string",
        "null"
      ],
      "description": "Optional editor schema URL or local path. Flare treats it as metadata and never fetches it."
    },
    "schemaVersion": {
      "type": "integer",
      "const": 1,
      "default": 1,
      "description": "Manifest format version supported by Flare."
    },
    "apiVersion": {
      "type": "integer",
      "const": 1,
      "description": "Plugin Host API version."
    },
    "id": {
      "type": "string",
      "description": "Stable reverse-domain plugin ID. Keep it unchanged for upgrades.",
      "pattern": "^(?:[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+)(?![\\s\\S])"
    },
    "version": {
      "type": "string",
      "description": "Plugin SemVer, independent of the npm SDK version. GitHub installation requires a matching stable tag.",
      "pattern": "^(?:(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)(?![\\s\\S])"
    },
    "defaultLocale": {
      "type": "string",
      "description": "Default locale catalog when localized text is used.",
      "pattern": "^(?:[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*)(?![\\s\\S])",
      "default": "en"
    },
    "name": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "anyOf": [
        {
          "$ref": "#/definitions/text"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "permissions": {
      "$ref": "#/definitions/permissions"
    },
    "platform": {
      "$ref": "#/definitions/platform"
    }
  },
  "required": [
    "apiVersion",
    "id",
    "version",
    "name",
    "platform"
  ],
  "definitions": {
    "identifier": {
      "type": "string",
      "description": "Case-sensitive identifier beginning with a letter.",
      "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]{0,127})(?![\\s\\S])"
    },
    "text": {
      "description": "A literal string or a localized key with a fallback. Flare checks referenced keys against locale catalogs.",
      "oneOf": [
        {
          "type": "string",
          "description": "Non-blank display text; the Host also checks its UTF-16 length.",
          "pattern": "\\S",
          "maxLength": 4096
        },
        {
          "$ref": "#/definitions/localizedText"
        }
      ]
    },
    "localizedText": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "$ref": "#/definitions/identifier"
        },
        "fallback": {
          "type": "string",
          "description": "Non-blank display text; the Host also checks its UTF-16 length.",
          "pattern": "\\S",
          "maxLength": 4096
        }
      },
      "required": [
        "key",
        "fallback"
      ]
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authOrigins": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Exact canonical HTTPS origin; no path, credentials, wildcard, or trailing slash. Flare checks DNS/port normalization.",
            "pattern": "^(?:https://[a-z0-9.-]+(?::[0-9]{1,5})?)(?![\\s\\S])"
          },
          "default": [],
          "maxItems": 16,
          "uniqueItems": true
        },
        "mediaNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Allow media loading from any website/CDN. Adding this permission requires review."
        }
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable platform identity, unique across plugins and built-in platforms.",
          "pattern": "^(?:[A-Za-z][A-Za-z0-9_.-]{0,63})(?![\\s\\S])"
        },
        "name": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "detector": {
          "anyOf": [
            {
              "$ref": "#/definitions/detector"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "loginMethods": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/loginMethod"
          },
          "default": [],
          "description": "At most one method per interaction; method and field IDs must be unique. Flare checks these semantic constraints."
        },
        "capabilities": {
          "$ref": "#/definitions/capabilities"
        },
        "timelines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/timeline"
          },
          "default": []
        },
        "profileTabs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/profileTab"
          },
          "default": []
        },
        "deepLinks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/deepLink"
          },
          "default": [],
          "maxItems": 64
        },
        "composeDefaults": {
          "anyOf": [
            {
              "$ref": "#/definitions/compose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "guest": {
          "anyOf": [
            {
              "$ref": "#/definitions/guest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "credentialSchemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1,
          "description": "Bump when saved credentials become incompatible; accounts may need to log in again."
        },
        "timelineSchemaVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 1,
          "description": "Bump for incompatible timeline identity/parameter changes."
        }
      },
      "required": [
        "id",
        "name"
      ],
      "allOf": [
        {
          "if": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "properties": {
                  "flare.datasource.timeline/v1": true
                },
                "required": [
                  "flare.datasource.timeline/v1"
                ]
              }
            }
          },
          "then": {
            "required": [
              "timelines"
            ],
            "properties": {
              "timelines": {
                "type": "array",
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "properties": {
                    "defaultForNewAccount": {
                      "const": true
                    }
                  },
                  "required": [
                    "defaultForNewAccount"
                  ]
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "timelines"
            ],
            "properties": {
              "timelines": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "required": [
                  "flare.datasource.timeline/v1"
                ],
                "properties": {
                  "flare.datasource.timeline/v1": true
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "properties": {
                  "flare.datasource.tab-catalog/v1": true
                },
                "required": [
                  "flare.datasource.tab-catalog/v1"
                ]
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "required": [
                  "flare.datasource.timeline/v1"
                ],
                "properties": {
                  "flare.datasource.timeline/v1": true
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "profileTabs"
            ],
            "properties": {
              "profileTabs": {
                "type": "array",
                "minItems": 1
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "required": [
                  "flare.datasource.profile/v1"
                ],
                "properties": {
                  "flare.datasource.profile/v1": {
                    "type": "object",
                    "properties": {
                      "operations": {
                        "type": "object",
                        "properties": {
                          "timeline": true
                        },
                        "required": [
                          "timeline"
                        ]
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "properties": {
                  "flare.datasource.compose/v1": true
                },
                "required": [
                  "flare.datasource.compose/v1"
                ]
              }
            }
          },
          "then": {
            "required": [
              "composeDefaults"
            ],
            "properties": {
              "composeDefaults": {
                "$ref": "#/definitions/compose"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "composeDefaults"
            ],
            "properties": {
              "composeDefaults": {
                "type": "object"
              }
            }
          },
          "then": {
            "type": "object",
            "required": [
              "capabilities"
            ],
            "properties": {
              "capabilities": {
                "type": "object",
                "required": [
                  "flare.datasource.compose/v1"
                ],
                "properties": {
                  "flare.datasource.compose/v1": true
                }
              }
            }
          }
        }
      ]
    },
    "detector": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "priority": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000,
          "default": 0
        }
      }
    },
    "guest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "loginInteraction": {
      "type": "string",
      "enum": [
        "OAuth",
        "Password",
        "CredentialImport",
        "WebCookie",
        "Form"
      ]
    },
    "loginFieldType": {
      "type": "string",
      "enum": [
        "Text",
        "Username",
        "Password",
        "Otp",
        "Secret"
      ]
    },
    "loginField": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "type": {
          "$ref": "#/definitions/loginFieldType"
        },
        "label": {
          "$ref": "#/definitions/text"
        },
        "placeholder": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "id",
        "type",
        "label"
      ]
    },
    "loginMethod": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/definitions/identifier"
        },
        "interaction": {
          "$ref": "#/definitions/loginInteraction"
        },
        "title": {
          "$ref": "#/definitions/text"
        },
        "description": {
          "anyOf": [
            {
              "$ref": "#/definitions/text"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/loginField"
          },
          "default": []
        },
        "cookie": {
          "anyOf": [
            {
              "$ref": "#/definitions/webCookie"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "interaction",
        "title"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "interaction": {
                "enum": [
                  "OAuth",
                  "WebCookie"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "fields": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction": {
                "const": "WebCookie"
              }
            }
          },
          "then": {
            "required": [
              "cookie"
            ],
            "properties": {
              "cookie": {
                "$ref": "#/definitions/webCookie"
              }
            }
          },
          "else": {
            "properties": {
              "cookie": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "interaction": {
                "enum": [
                  "Password",
                  "CredentialImport",
                  "Form"
                ]
              }
            }
          },
          "then": {
            "required": [
              "fields"
            ],
            "properties": {
              "fields": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "webCookie": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "startUrl": {
          "type": "string",
          "description": "HTTPS start URL on an approved auth origin, or $accountOrigin with an optional path.",
          "pattern": "^(?:(?:\\$accountOrigin(?:/[^\\s]*)?|https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[^\\s]*)?))(?![\\s\\S])"
        },
        "probes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cookieProbe"
          },
          "default": [],
          "minItems": 1,
          "maxItems": 16
        }
      },
      "required": [
        "startUrl",
        "probes"
      ]
    },
    "cookieProbe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Probe URL on an approved HTTPS auth origin or $accountOrigin.",
          "pattern": "^(?:(?:\\$accountOrigin(?:/[^\\s]*)?|https://[A-Za-z0-9.-]+(?::[0-9]{1,5})?(?:/[^\\s]*)?))(?![\\s\\S])"
        },
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/cookieRequirement"
          },
          "default": [],
          "minItems": 1,
          "maxItems": 32,
          "description": "Cookie names must be unique ignoring case; checked by Flare."
        }
      },
      "required": [
        "url",
        "cookies"
      ]
    },
    "cookieRequirement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Cookie name.",
          "pattern": "^(?:[!#$%&'*+.^_`|~0-9A-Za-z-]{1,128})(?![\\s\\S])"
        },
        "required": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [
        "name"
      ]
    },
    "pageDirection": {
      "type": "string",
      "enum": [
        "refresh",
        "older",
        "newer"
      ]
    },
    "notificationFilter": {
      "type": "string",
      "enum": [
        "all",
        "mention",
        "comment",
        "like"
      ]
    },
    "relationAction": {
      "type": "string",
      "enum": [
        "follow",
        "block",
        "mute"
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "directions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pageDirection"
          },
          "default": [],
          "uniqueItems": true,
          "maxItems": 3
        }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "additionalProperties": {
            "$ref": "#/definitions/operation"
          }
        },
        "notificationFilters": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/notificationFilter"
          },
          "default": [],
          "uniqueItems": true
        },
        "relationActions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/relationAction"
          },
          "default": [],
          "uniqueItems": true
        }
      },
      "required": [
        "operations"
      ]
    },
    "capability-timeline": {
      "type": "object",
      "description": "timeline capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "page": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "page"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "capability-search": {
      "type": "object",
      "description": "search capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "posts": {
                  "$ref": "#/definitions/operation"
                },
                "profiles": {
                  "$ref": "#/definitions/operation"
                },
                "discoverPosts": {
                  "$ref": "#/definitions/operation"
                },
                "discoverProfiles": {
                  "$ref": "#/definitions/operation"
                },
                "discoverHashtags": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "posts",
                "profiles",
                "discoverPosts",
                "discoverProfiles",
                "discoverHashtags"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "capability-profile": {
      "type": "object",
      "description": "profile capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "byId": {
                  "$ref": "#/definitions/operation"
                },
                "byHandle": {
                  "$ref": "#/definitions/operation"
                },
                "timeline": {
                  "$ref": "#/definitions/operation"
                },
                "following": {
                  "$ref": "#/definitions/operation"
                },
                "followers": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "byId",
                "byHandle"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "capability-post": {
      "type": "object",
      "description": "post capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "detail": {
                  "$ref": "#/definitions/operation"
                },
                "context": {
                  "$ref": "#/definitions/operation"
                },
                "delete": {
                  "$ref": "#/definitions/operation"
                },
                "mutate": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "detail"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "capability-relation": {
      "type": "object",
      "description": "relation capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "state": {
                  "$ref": "#/definitions/operation"
                },
                "mutate": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "state",
                "mutate"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "minItems": 1
            }
          },
          "required": [
            "relationActions"
          ]
        }
      ]
    },
    "capability-compose": {
      "type": "object",
      "description": "compose capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
          "$ref": "#/definitions/capability"
        },
        {
          "type": "object",
          "properties": {
            "operations": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "publish": {
                  "$ref": "#/definitions/operation"
                }
              },
              "required": [
                "publish"
              ]
            },
            "notificationFilters": {
              "type": "array",
              "maxItems": 0
            },
            "relationActions": {
              "type": "array",
              "maxItems": 0
            }
          }
        }
      ]
    },
    "capability-notification": {
      "type": "object",
      "description": "notification capability. Implement every declared operation in plugin.js.",
      "allOf": [
        {
