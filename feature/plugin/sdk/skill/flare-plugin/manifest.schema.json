      ]
    },
    "composeLanguage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "maxCount"
      ]
    },
    "compose": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "text": {
          "anyOf": [
            {
              "$ref": "#/definitions/composeText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "media": {
          "anyOf": [
            {
              "$ref": "#/definitions/composeMedia"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "visibility": {
          "anyOf": [
            {
              "$ref": "#/definitions/composeVisibility"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "contentWarning": {
          "type": "boolean",
          "default": false
        },
        "poll": {
          "anyOf": [
            {
              "$ref": "#/definitions/composePoll"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "language": {
          "anyOf": [
            {
