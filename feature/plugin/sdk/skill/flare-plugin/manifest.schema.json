    "deepLinkSegment": {
      "oneOf": [
        {
          "$ref": "#/definitions/literalSegment"
        },
        {
          "$ref": "#/definitions/captureSegment"
        }
      ]
    },
    "literalSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "literal"
        },
        "value": {
          "type": "string",
          "description": "One literal URL path segment.",
          "pattern": "^(?:[^/\\s?#]{1,256})(?![\\s\\S])"
        }
      },
      "required": [
        "type",
        "value"
      ]
    },
    "captureSegment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "capture"
        },
        "name": {
          "$ref": "#/definitions/identifier"
        }
      },
      "required": [
        "type",
        "name"
      ]
    },
    "deepLinkTargetType": {
      "type": "string",
      "enum": [
        "Profile",
        "Post",
        "Timeline",
        "Browser"
      ]
    },
    "deepLinkTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/definitions/deepLinkTargetType"
        },
        "value": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "description": "Captured placeholders for Profile/Post, a declared timeline ID for Timeline, absent/null for Browser."
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Browser"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "else": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "Profile",
                  "Post"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(?:(?:\\{[A-Za-z][A-Za-z0-9_.-]{0,127}\\})+)(?![\\s\\S])"
              }
            }
          }
        }
      ]
    },
    "deepLink": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "description": "Approved exact auth origin or $accountOrigin; Flare checks permission membership.",
          "default": "$accountOrigin",
          "pattern": "^(?:(?:\\$accountOrigin|https://[a-z0-9.-]+(?::[0-9]{1,5})?))(?![\\s\\S])"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/deepLinkSegment"
          },
          "default": [],
          "minItems": 1,
          "maxItems": 32
        },
        "target": {
          "$ref": "#/definitions/deepLinkTarget"
        }
      },
      "required": [
        "path",
        "target"
      ]
    },
