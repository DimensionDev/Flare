{
  "name": "flare",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "kotlin:build:dev": "../gradlew -p .. :web-shared:wasmJsBrowserDevelopmentLibraryDistribution",
    "kotlin:build:prod": "../gradlew -p .. :web-shared:wasmJsBrowserProductionLibraryDistribution",
    "kotlin:patch:prod": "node scripts/patch-kotlin-wasm-import-object.mjs",
    "i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale",
    "dev": "pnpm kotlin:build:dev && vite dev",
    "build": "pnpm kotlin:build:prod && pnpm kotlin:patch:prod && FLARE_WEB_SHARED_LIBRARY=productionLibrary vite build",
    "preview": "vite preview",
    "prepare": "pnpm i18n:compile && svelte-kit sync || echo ''",
    "check": "pnpm kotlin:build:dev && pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test:codegen": "node --test scripts/*.test.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-m-function-matcher": "^2.2.12",
    "@inlang/plugin-message-format": "^4.4.3",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "daisyui": "^5.7.22",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@androidx/sqlite-web-worker": "file:../shared/sqlite-web-worker",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/svelte-fontawesome": "^0.2.4",
    "@js-joda/core": "6.1.0",
    "@sqlite.org/sqlite-wasm": "3.53.0-build1",
    "dayjs": "^1.11.23",
    "firebase": "^12.18.0",
    "ws": "8.21.3"
  }
}
